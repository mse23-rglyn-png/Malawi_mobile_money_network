  margin: 0;
  opacity: .9;
}

main {
  max-width: 1050px;
  margin: 22px auto;
  padding: 0 16px 35px;
}

.card {
  background: white;
  border: 1px solid #dce4ef;
  border-radius: 12px;
  padding: 18px;
  margin-bottom: 18px;
}

h2 {
  margin: 0 0 14px;
  color: #173b68;
  font-size: 1.2rem;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: end;
}

